# Local-only defaults. Replace all passwords and the JWT secret before any shared deployment.
POSTGRES_DB=noomin
POSTGRES_USER=noomin
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
REDIS_PASSWORD=replace-with-a-url-safe-random-password
DATABASE_URL=postgresql+psycopg://noomin:replace-with-a-local-postgres-password@db:5432/noomin
REDIS_URL=redis://:replace-with-a-url-safe-random-password@redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
JWT_SECRET_KEY=change-this-to-a-random-secret-before-deployment
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
