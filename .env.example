# Copy to .env for local development. Change credentials before any shared deployment.
POSTGRES_DB=noomin
POSTGRES_USER=noomin
POSTGRES_PASSWORD=noomin_dev_only
DATABASE_URL=postgresql+psycopg://noomin:noomin_dev_only@db:5432/noomin
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
JWT_SECRET_KEY=change-this-to-a-random-secret-before-deployment
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
